{
  "scripts": {
    "check": "node devtools/check_syntax.mjs",
    "scan-assets": "node tools/map-editor/scan-assets.js",
    "verify-maps": "node devtools/verify_field_map_themes.mjs",
    "verify-field-scene": "node --no-warnings --loader ./devtools/_dungeon_enemies_loader.mjs devtools/verify_field_scene_themes.mjs",
    "verify-save": "node --no-warnings --loader ./devtools/_dungeon_enemies_loader.mjs devtools/verify_save_no_circular.mjs",
    "verify-package-size": "node devtools/verify_package_size.mjs",
    "verify-audio": "node devtools/verify_audio_engine.mjs",
    "verify-audio-quality": "./.venv/bin/python tools/audio/verify_encode_quality.py",
    "encode-audio": "node tools/audio/encode_mp3.js && node tools/audio/deploy_audio.js",
    "optimize-images": "node tools/images/optimize_png.js",
    "verify-hit-feedback": "node --no-warnings --loader ./devtools/_dungeon_enemies_loader.mjs devtools/verify_hit_feedback.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/parser": "^7.29.2",
